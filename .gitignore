# output.
reports/

# Secrets
.env
*.pem

# Test/tool caches
.pytest_cache/
.uv-cache/

# Frontend (frontend/dist is covered by dist/ above)
frontend/node_modules/

# Local build-context staging for the Cloud Run image (bakes in a completed
# index) — large binary data, never meant to be committed.
cloudrun-data/

# Local Claude Code project notes — not part of the submission
CLAUDE.md
AGENTS.md
hackathon.md
# Local Markdown documentation; keep the project README trackable
*.md
!README.md

