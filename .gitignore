# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated data — reproducible via voice_rag.pipeline.ingestion /
# voice_rag.pipeline.chunking CLIs (see README.md), not source.
# data/processed alone is ~1.7GB.
data/

# Per-language JSON stats from voice_rag.pipeline.ingestion.analyze —
# regenerate via the command in README.md rather than tracking generated
# output.
#
# Exception: the latency benchmark result README.md cites as evidence for its
# P50/P70/P100 numbers. Tracked so those claims are checkable from a clean
# clone instead of asking the reader to take them on trust and re-run a long
# benchmark against a 964,603-chunk index. Negated level by level because git
# does not descend into an excluded directory. The .md rendering of the same
# data stays ignored — README.md is the repo's only markdown doc.
reports/*
!reports/latency_benchmark/
reports/latency_benchmark/*
!reports/latency_benchmark/*.json

# Secrets
.env
*.pem

# Test/tool caches
.pytest_cache/
.uv-cache/

# Frontend (frontend/dist is covered by dist/ above)
frontend/node_modules/

# Local build-context staging for the Cloud Run image (bakes in a completed
# index) — large binary data, never meant to be committed.
cloudrun-data/

# Local Claude Code project notes — not part of the submission
CLAUDE.md
AGENTS.md
hackathon.md
# Local Markdown documentation; keep the project README trackable
*.md
!README.md

# Large exports and audio files
hindi_index_export.tar.gz
*.wav
